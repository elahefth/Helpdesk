{
  "name": "@helpdesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "seed:admin": "bun --env-file=../../.env src/seed.ts",
    "seed:test": "bun --env-file=../../.env.test src/seed.ts",
    "email:send": "bun --env-file=../../.env src/dev/send-inbound-email.ts",
    "db:generate": "bun --env-file=../../.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env node_modules/.bin/drizzle-kit migrate",
    "db:migrate:test": "bun --env-file=../../.env.test node_modules/.bin/drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "@helpdesk/shared": "workspace:*",
    "better-auth": "^1.6.29",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9"
  }
}
