# Reference copy of .env.test. Unlike .env, the real .env.test *is* committed —
# it holds nothing secret — so this file exists only to document the contract.

NODE_ENV=test
PORT=3001

# Must match `baseURL` in e2e/playwright.config.ts exactly.
WEB_ORIGIN=http://localhost:5174

# The tmpfs container from compose.yaml's `test` profile, never dev's 5432.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk_test

BETTER_AUTH_SECRET=e2e-only-secret-not-used-anywhere-real
BETTER_AUTH_URL=http://localhost:3001
