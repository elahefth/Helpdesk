# Keep secrets, local state and host-built artefacts out of the build context.
# node_modules in particular: a macOS install copied over the Linux one would
# carry the wrong native binaries.
**/node_modules
**/dist
.git
.env
.env.*
!.env.example
.pgdata-test
.idea
.claude
.agents
e2e/playwright
e2e/test-results
e2e/playwright-report
e2e/blob-report
*.log
.DS_Store
