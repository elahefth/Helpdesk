{
  "name": "helpdesk",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "dev:api": "bun run --filter='@helpdesk/api' dev",
    "dev:web": "bun run --filter='@helpdesk/web' dev",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "env -u DATABASE_URL -u BETTER_AUTH_SECRET bun --env-file=/dev/null test apps/api packages",
    "test:web": "bun run --filter='@helpdesk/web' test",
    "test:e2e": "bun run --filter='@helpdesk/e2e' test",
    "test:e2e:ui": "bun run --filter='@helpdesk/e2e' test:ui",
    "e2e:install": "bun run --filter='@helpdesk/e2e' install:browsers",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:web",
    "seed:admin": "bun run --filter='@helpdesk/api' seed:admin",
    "email:send": "bun run --filter='@helpdesk/api' email:send",
    "db:generate": "bun run --filter='@helpdesk/api' db:generate",
    "db:migrate": "bun run --filter='@helpdesk/api' db:migrate",
    "db:studio": "bun run --filter='@helpdesk/api' db:studio",
    "db:up:test": "./e2e/scripts/test-db.sh up",
    "db:down:test": "./e2e/scripts/test-db.sh down",
    "db:reset:test": "./e2e/scripts/test-db.sh reset",
    "db:up:test:docker": "docker compose --profile test up -d postgres-test",
    "db:migrate:test": "bun run --filter='@helpdesk/api' db:migrate:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "6",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
