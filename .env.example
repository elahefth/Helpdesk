# Core
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# Auth — generate with: openssl rand -base64 32
# Optional in development, required in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seed account — HTTP sign-up is disabled, so the first admin comes from
# `bun run seed:admin`. Flags override these: --email --password --name --role
SEED_ADMIN_EMAIL=admin@helpdesk.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# AI (Phase 6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Reply polishing — the "Polish" button on a ticket's reply form rewrites an
# agent's draft through OpenRouter. Optional everywhere, including production:
# without a key the route answers 503 and says so, rather than the API refusing
# to boot over a feature that is a convenience. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Preference order, not one model: the first is the primary and the rest are
# fallbacks OpenRouter routes to when it is throttled. Free models sit behind a
# shared upstream pool that throttles and recovers minute to minute, so a lone
# id makes the Polish button work intermittently for reasons no agent can see.
# Five different providers on purpose — entries from one provider share the
# pool that just throttled. A throttled model refuses in under a second, so a
# long chain is nearly free to walk.
# Free tiers also get retired and renamed, which is the other reason this is
# configuration rather than code.
# Pick a model that answers directly. A *reasoning* model (openai/gpt-5-nano,
# anything :thinking) spends the output budget thinking before it writes, and a
# rewrite this short is finished by the budget before the reply starts — it
# comes back empty, which the route reports as "the model returned an empty
# reply". Cheap instruct models do this job well; measured at roughly a
# hundredth of a cent per press.
# A paid primary with a free model behind it, which is what an install with any
# credit at all wants: free models alone make the button work intermittently.
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct,google/gemini-2.5-flash-lite,google/gemma-4-31b-it:free
# All-free alternative, for an install with no credit — expect the occasional
# "rate-limited right now":
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,inclusionai/ling-3.0-flash-vl:free,nex-agi/nex-n2.5-pro:free,qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-mini:free

# Inbound email
# The mailbox tickets are created from. POST /api/inbound-email refuses anything
# addressed elsewhere, which keeps it an ingestion endpoint rather than an open
# "create a ticket" API.
SUPPORT_EMAIL=support@helpdesk.test

# Shared secret the delivering source presents as `x-inbound-secret`. That
# endpoint is necessarily unauthenticated — a mail provider holds no session —
# so this header is its only guard. Optional in development, required in
# production. Generate with: openssl rand -base64 32
INBOUND_EMAIL_SECRET=

# Email provider (Phase 5 — nothing reads these yet)
EMAIL_SOURCE=mock
EMAIL_SINK=outbox
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SIGNING_KEY=
MAILGUN_INBOUND_ADDRESS=
