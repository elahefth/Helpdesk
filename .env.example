# Core
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk

# Auth — generate with: openssl rand -base64 32
# Optional in development, required in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seed account — HTTP sign-up is disabled, so the first admin comes from
# `bun run seed:admin`. Flags override these: --email --password --name --role
SEED_ADMIN_EMAIL=admin@helpdesk.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# AI (Phase 6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Email (Phase 5)
EMAIL_SOURCE=mock
EMAIL_SINK=outbox
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SIGNING_KEY=
MAILGUN_INBOUND_ADDRESS=
