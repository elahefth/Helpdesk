# Environment for the Playwright suite. Committed on purpose: every value here
# is throwaway, and CI needs the file to exist without a secrets step.
#
# Loaded only by the E2E API process, which Playwright starts itself
# (`bun --env-file=../../.env.test src/index.ts` — see e2e/playwright.config.ts).
# `bun run dev` still reads ../../.env and is unaffected.

NODE_ENV=test
PORT=3001

# Must match `baseURL` in e2e/playwright.config.ts exactly — it feeds both the
# CORS allowlist and Better Auth's trustedOrigins, and both compare the browser's
# Origin header verbatim ("localhost" and "127.0.0.1" are not interchangeable).
WEB_ORIGIN=http://localhost:5174

# The tmpfs container from compose.yaml's `test` profile, never the dev one on 5432:
#   docker compose --profile test up -d postgres-test
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk_test

# Fixed rather than random so sessions survive a rerun; >=32 chars to satisfy env.ts.
BETTER_AUTH_SECRET=e2e-only-secret-not-used-anywhere-real
BETTER_AUTH_URL=http://localhost:3001

# The address POST /api/inbound-email accepts mail for. Stated rather than left
# to env.ts's default so a spec asserting the 422 for a wrong recipient has
# something to point at.
SUPPORT_EMAIL=support@helpdesk.test
